# Appwrite Configuration (Required for Production Deployment)
# Configure these in your hosting provider's (Vercel/Netlify/etc.) Production Environment Variables dashboard

# [REQUIRED IN PRODUCTION] Your Appwrite Project ID from Appwrite Console (Settings > Project ID)
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_project_id

# [OPTIONAL] Appwrite Endpoint (Defaults to https://cloud.appwrite.io/v1 if unset)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# [OPTIONAL] Appwrite Database ID (Defaults to inventory_lite_db if unset)
NEXT_PUBLIC_APPWRITE_DATABASE_ID=inventory_lite_db

# Server-Only API Key (Used strictly for setup scripts, MUST NOT have NEXT_PUBLIC_ prefix!)
APPWRITE_API_KEY=your_server_api_key_optional_for_setup

# Application Environment
NODE_ENV=development
